{%- macro concurrency() -%}
concurrency:
  {%- raw %}
  group: "main-${{ github.ref_name }}-${{ github.workflow }}"
  {%- endraw %}
  cancel-in-progress: true
{%- endmacro -%}

{%- macro checkout(deep=false) -%}
- name: "Checkout"
  uses: "actions/checkout@v6"
  with:
    path: "pulp-cli{{ cookiecutter.__app_label_suffix }}"
    {%- if deep %}
    fetch-depth: 0
    {%- endif %}
{%- endmacro -%}

{%- macro download_wheels() -%}
- name: "Download wheels"
  uses: "actions/download-artifact@v8"
  with:
    name: "pulp_cli_packages"
{%- endmacro -%}

{%- macro setup_python(version="3.14") -%}
- name: "Set up Python"
  uses: "actions/setup-python@v6"
  with:
    python-version: "{{ version }}"
    allow-prereleases: true
{%- endmacro -%}

{%- macro install_uv() -%}
- name: "Install uv"
  uses: "astral-sh/setup-uv@v7"
  with:
    enable-cache: true
{%- endmacro -%}

{%- macro setup_git() -%}
- name: "Setup git"
  run: |
    git config user.name pulpbot
    git config user.email pulp-infra@redhat.com
{%- endmacro -%}

{%- macro create_pr(branch, title) -%}
- name: "Create Pull Request"
  uses: "peter-evans/create-pull-request@v8"
  id: "create_pr"
  with:
    title: "{{ title }}"
    body: ""
    branch: "{{ branch }}"
    delete-branch: true
    path: "pulp-cli{{ cookiecutter.__app_label_suffix }}"
{%- raw %}
- name: "Mark PR automerge"
  run: |
    gh pr merge --rebase --auto "${{ steps.create_pr.outputs.pull-request-number }}"
  if: "steps.create_pr.outputs.pull-request-number"
  env:
    GH_TOKEN: "${{ secrets.GITHUB_TOKEN }}"
  continue-on-error: true
{%- endraw %}
{%- endmacro -%}
